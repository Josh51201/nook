# Copy this file to .env and fill in real values from your Supabase project's
# Settings -> API page. Never commit the real .env file (it's gitignored).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sitter Sheet Nook: the web address where you uploaded web/sitter/dist
# (e.g. https://nook-sitter.netlify.app). Leave empty until it's hosted.
EXPO_PUBLIC_SITTER_PAGE_URL=
