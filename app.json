{
  "expo": {
    "name": "Nook",
    "slug": "nook",
    "scheme": "nook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf7f2",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#8a5a3b"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nook uses your photos so you can keep pictures of the cards you get.",
          "cameraPermission": "Nook uses your camera so you can snap the cards you get."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mynookapp.nook",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.mynookapp.nook",
      "adaptiveIcon": {
        "backgroundColor": "#7a4a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43bfa6a4-4972-434c-bc75-998bbfaabef8"
      }
    },
    "owner": "josh51201s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/43bfa6a4-4972-434c-bc75-998bbfaabef8"
    }
  }
}
