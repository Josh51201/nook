# Copy to .env.test.local (gitignored, never commit it). Only needed to run
# the RLS tests in tests/gift-nook-rls.test.ts — the app itself never uses
# the service role key, only the anon key from .env.
#
# Find it in Supabase: Project Settings -> API -> service_role secret.
# This key bypasses Row Level Security entirely — keep it out of the app,
# out of git, and out of chat.

SUPABASE_SERVICE_ROLE_KEY=
